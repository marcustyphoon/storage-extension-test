{
  "manifest_version": 3,

  "name": "Extension storage test",
  "version": "0.1",

  "permissions": ["storage"],
  "web_accessible_resources": [
    {
      "matches": ["*://*.example.com/*"],
      "resources": ["*.js"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["*://*.example.com/*"],
      "js": ["content_scripts/example.js"]
    }
  ]
}
